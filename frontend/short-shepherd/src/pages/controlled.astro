---
// Standalone Astro page (NOT a Starlight docs entry).
// The BAN/SPOILER lists are fetched LIVE in the browser at runtime —
// nothing is fetched at build time, so the build succeeds with the API down.
const pageTitle = "Banned & Spoilered — Zuri Cat Tree";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <style>
      :root {
        --bg: #1b1b22;
        --panel: #24242e;
        --border: #3a3a46;
        --text: #e8e8ee;
        --muted: #a3a3b0;
        --accent: #7c6cff;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        font-family:
          system-ui,
          -apple-system,
          Segoe UI,
          Roboto,
          sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.5;
      }
      .wrap {
        max-width: 1000px;
        margin: 0 auto;
        padding: 2rem 1.25rem 4rem;
      }
      h1 {
        margin: 0 0 0.25rem;
        font-size: 1.9rem;
      }
      .sub {
        color: var(--muted);
        margin: 0 0 1.5rem;
      }
      .back {
        color: var(--accent);
        text-decoration: none;
        font-size: 0.9rem;
      }
      .back:hover {
        text-decoration: underline;
      }
      .controls {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-bottom: 1.25rem;
      }
      .controls input,
      .controls select {
        background: var(--panel);
        color: var(--text);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 0.55rem 0.75rem;
        font-size: 0.95rem;
      }
      .controls input {
        flex: 1 1 240px;
        min-width: 0;
      }
      .controls input:focus,
      .controls select:focus {
        outline: 2px solid var(--accent);
        outline-offset: 1px;
      }
      .panel {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 10px;
        overflow: hidden;
      }
      table {
        width: 100%;
        border-collapse: collapse;
      }
      th,
      td {
        text-align: left;
        padding: 0.7rem 0.9rem;
        border-bottom: 1px solid var(--border);
        vertical-align: top;
      }
      th {
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--muted);
        background: #2b2b36;
      }
      tr:last-child td {
        border-bottom: none;
      }
      .alias {
        font-weight: 600;
      }
      .type {
        color: var(--muted);
        text-transform: capitalize;
      }
      .reason {
        color: var(--muted);
      }
      .reason.none {
        font-style: italic;
        opacity: 0.6;
      }
      .badge {
        display: inline-block;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 0.2rem 0.55rem;
        border-radius: 999px;
        border: 1px solid transparent;
        white-space: nowrap;
      }
      .badge.banned {
        background: rgba(220, 53, 69, 0.18);
        color: #ff8088;
        border-color: rgba(220, 53, 69, 0.5);
      }
      .badge.spoilered {
        background: rgba(255, 176, 32, 0.16);
        color: #ffce6a;
        border-color: rgba(255, 176, 32, 0.5);
      }
      .state {
        padding: 2.5rem 1rem;
        text-align: center;
        color: var(--muted);
      }
      .state.error {
        color: #ff8088;
      }
      .state .big {
        font-size: 1.05rem;
        color: var(--text);
        margin-bottom: 0.35rem;
      }
      .retry {
        margin-top: 1rem;
        background: var(--accent);
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 0.5rem 1rem;
        font-size: 0.9rem;
        cursor: pointer;
      }
      .retry:hover {
        filter: brightness(1.1);
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <a class="back" href="/">&larr; Back to the rules</a>
      <h1>Banned &amp; Spoilered</h1>
      <p class="sub">
        Live list of controlled content (artists, characters, and tags). Updates
        automatically as moderators change it.
      </p>

      <div class="controls">
        <input
          id="search"
          type="text"
          placeholder="Search by alias…"
          autocomplete="off"
        />
        <select id="type-filter" aria-label="Filter by type">
          <option value="all">All types</option>
          <option value="artist">Artist</option>
          <option value="character">Character</option>
          <option value="tag">Tag</option>
        </select>
      </div>

      <div class="panel">
        <div id="content"></div>
      </div>
    </div>

    <script is:inline>
      // Change this if the backend moves.
      const API_BASE = "http://localhost:8080";

      const contentEl = document.getElementById("content");
      const searchEl = document.getElementById("search");
      const typeFilterEl = document.getElementById("type-filter");

      let allItems = []; // full dataset from the API

      function esc(s) {
        return String(s).replace(/[&<>"']/g, (c) => {
          return {
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;",
          }[c];
        });
      }

      function showLoading() {
        contentEl.innerHTML =
          '<div class="state"><div class="big">Loading…</div>Fetching the controlled-content list.</div>';
      }

      function showError() {
        contentEl.innerHTML =
          '<div class="state error"><div class="big">Couldn\'t reach the rules service</div>' +
          "The controlled-content list is temporarily unavailable. Please try again in a moment." +
          '<div><button class="retry" id="retry">Retry</button></div></div>';
        const retry = document.getElementById("retry");
        if (retry) retry.addEventListener("click", load);
      }

      function showEmpty(filtered) {
        const msg = filtered
          ? "No entries match your search."
          : "Nothing controlled yet.";
        contentEl.innerHTML =
          '<div class="state"><div class="big">' + esc(msg) + "</div></div>";
      }

      function renderTable(items) {
        if (!items.length) {
          // Distinguish "empty dataset" from "filtered to nothing".
          showEmpty(allItems.length > 0);
          return;
        }
        let rows = "";
        for (const it of items) {
          const status = String(it.status || "").toLowerCase();
          const badgeClass =
            status === "banned" || status === "spoilered"
              ? status
              : "spoilered";
          const reason =
            it.reason === null || it.reason === undefined || it.reason === ""
              ? '<span class="reason none">—</span>'
              : '<span class="reason">' + esc(it.reason) + "</span>";
          rows +=
            "<tr>" +
            '<td class="alias">' +
            esc(it.alias ?? "") +
            "</td>" +
            '<td class="type">' +
            esc(it.type ?? "") +
            "</td>" +
            '<td><span class="badge ' +
            badgeClass +
            '">' +
            esc(status || "unknown") +
            "</span></td>" +
            "<td>" +
            reason +
            "</td>" +
            "</tr>";
        }
        contentEl.innerHTML =
          "<table><thead><tr>" +
          "<th>Alias</th><th>Type</th><th>Status</th><th>Reason</th>" +
          "</tr></thead><tbody>" +
          rows +
          "</tbody></table>";
      }

      function applyFilters() {
        const q = searchEl.value.trim().toLowerCase();
        const type = typeFilterEl.value;
        const filtered = allItems.filter((it) => {
          const matchType = type === "all" || it.type === type;
          const matchQ =
            !q ||
            String(it.alias ?? "")
              .toLowerCase()
              .includes(q);
          return matchType && matchQ;
        });
        renderTable(filtered);
      }

      async function load() {
        showLoading();
        try {
          const res = await fetch(API_BASE + "/api/controlled-content", {
            headers: { Accept: "application/json" },
          });
          if (!res.ok) throw new Error("HTTP " + res.status);
          const data = await res.json();
          allItems = Array.isArray(data) ? data : [];
          applyFilters();
        } catch (err) {
          console.error("Failed to load controlled content:", err);
          showError();
        }
      }

      searchEl.addEventListener("input", applyFilters);
      typeFilterEl.addEventListener("change", applyFilters);

      load();
    </script>
  </body>
</html>
