---
// The changelog: the network's major events (new rules, sections, staff
// joining or leaving, bans, bewares, incidents), grouped by day, newest
// first, rendered from src/data/changelog.json. The page
// description is the newest day, so a link to the list previews with what
// changed most recently; each day also has a page of its own
// (/changelog/<date>/) whose preview stays fixed. Tapping a day opens it in
// a dialog here and pushes that URL, which keeps the address bar shareable.
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import CopyLink from "../../components/CopyLink.astro";
import TelegramCopy from "../../components/TelegramCopy.astro";
import { dayViews, describeLatest, prHref } from "../../lib/changelog";
import { linkRules } from "../../lib/rules";

// The list's own history is the history of this page.
Astro.locals.revisionSource = "src/data/changelog.json";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// Each day carries its slug and permalink so the dialog and the per-day page
// agree on both; summaries are pre-rendered with their § links.
const items = dayViews(base).map((day) => ({
  ...day,
  changes: day.changes.map((c) => ({
    ...c,
    prHref: c.pr != null ? prHref(c.pr) : null,
    summaryHtml: linkRules(base, c.summary),
  })),
}));
---

<StarlightPage
  frontmatter={{
    title: "Changelog",
    description: describeLatest(),
    tableOfContents: false,
    prev: false,
    next: false,
  }}
>
  <p>
    What matters to members, by day, newest first: new rules, new sections,
    staff joining or leaving, bans, bewares and incidents. Tap a day to open it
    on its own, with a link you can copy. Smaller and technical changes are not
    listed; the full history is on{" "}
    <a href="https://github.com/CatShark-TreeHouse/wiki/commits/main/">GitHub</a
    >, and rule changes are also recorded in the{" "}
    <a href={`${base}/rules/network-rules/#amendment-log`}>Amendment Log</a>.
  </p>
  <ol id="cs-changelog" class="cs-changelog not-content">
    {
      items.map((day) => (
        <li class="cs-change" data-slug={day.slug}>
          <div class="cs-change-head">
            <span>{day.count}</span>
            {day.latest ? <span class="cs-badge latest">Latest</span> : null}
          </div>
          <h2 class="cs-change-title">
            <a class="cs-change-link" href={day.href}>
              <time datetime={day.date}>{day.heading}</time>
            </a>
          </h2>
          <ul class="cs-day-changes">
            {day.changes.map((c) => (
              <li class="cs-day-change">
                <p class="cs-day-change-title">
                  {c.pr != null ? (
                    <a class="cs-change-pr" href={c.prHref}>
                      #{c.pr}
                    </a>
                  ) : null}
                  <span>{c.title}</span>
                </p>
                <p class="cs-change-summary" set:html={c.summaryHtml} />
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</StarlightPage>

<dialog
  id="cs-change-modal"
  class="cs-modal"
  aria-labelledby="cs-change-modal-date"
>
  <div class="cs-card cs-change-card not-content">
    <div class="cs-change-head">
      <time id="cs-change-modal-date"></time>
      <span id="cs-change-modal-count"></span>
      <span id="cs-change-modal-latest" class="cs-badge latest" hidden
        >Latest</span
      >
      <button
        id="cs-change-modal-close"
        class="cs-modal-close"
        type="button"
        aria-label="Close"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
    <ul id="cs-change-modal-changes" class="cs-day-changes"></ul>
    <p class="cs-card-note cs-card-actions">
      <CopyLink href="" />
      <TelegramCopy />
      <a id="cs-change-modal-link" class="cs-modal-link" href=""
        >Open the day's page</a
      >
    </p>
  </div>
</dialog>

<script is:inline define:vars={{ items }}>
  // Days are real links to their own page, so a middle-click or a copied
  // link still works; a plain tap anywhere on a day opens the dialog here
  // and pushes that same URL, which keeps the address bar shareable.
  const list = document.getElementById("cs-changelog");
  const modal = document.getElementById("cs-change-modal");
  const fields = {
    date: document.getElementById("cs-change-modal-date"),
    count: document.getElementById("cs-change-modal-count"),
    latest: document.getElementById("cs-change-modal-latest"),
    changes: document.getElementById("cs-change-modal-changes"),
    link: document.getElementById("cs-change-modal-link"),
    copy: modal.querySelector("button[data-copy-link]"),
    telegram: modal.querySelector("button[data-telegram]"),
  };
  const bySlug = new Map(items.map((item) => [item.slug, item]));
  const listUrl = location.pathname + location.search;
  // Set while a restore is in flight, so the several ways of closing the
  // dialog cannot each push the browser back.
  let restoring = false;

  function esc(value) {
    return String(value)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function changeHtml(c) {
    const pr =
      c.pr != null
        ? '<a class="cs-change-pr" href="' +
          esc(c.prHref) +
          '">#' +
          c.pr +
          "</a>"
        : "";
    return (
      '<li class="cs-day-change"><p class="cs-day-change-title">' +
      pr +
      "<span>" +
      esc(c.title) +
      "</span></p>" +
      // Built at build time from the JSON, escaped and with § links added.
      '<p class="cs-change-summary">' +
      c.summaryHtml +
      "</p></li>"
    );
  }

  function openDay(slug, push) {
    const item = bySlug.get(slug);
    if (!item) return;
    fields.date.textContent = item.heading;
    fields.date.dateTime = item.date;
    fields.count.textContent = item.count;
    fields.latest.hidden = !item.latest;
    fields.changes.innerHTML = item.changes.map(changeHtml).join("");
    fields.link.href = item.href;
    fields.copy.dataset.copyLink = item.href;
    fields.telegram.dataset.day = JSON.stringify(item);
    if (push) history.pushState({ csChange: slug }, "", item.href);
    if (!modal.open) modal.showModal();
  }

  // Put the list URL back after the dialog is dismissed: step back over the
  // day we pushed, or rewrite the URL if the browser refuses the traversal.
  function restoreListUrl() {
    if (restoring) return;
    if (location.pathname + location.search === listUrl) return;
    restoring = true;
    if (history.state && history.state.csChange) history.back();
    else history.replaceState(null, "", listUrl);
    setTimeout(() => {
      if (location.pathname + location.search !== listUrl)
        history.replaceState(null, "", listUrl);
      restoring = false;
    }, 200);
  }

  function closeDay() {
    restoreListUrl();
    if (modal.open) modal.close();
  }

  list.addEventListener("click", (event) => {
    // The PR numbers and § references inside a day keep their own targets.
    const link = event.target.closest("a");
    if (link && !link.classList.contains("cs-change-link")) return;
    const day = event.target.closest(".cs-change[data-slug]");
    if (!day) return;
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
      return;
    if (event.button !== 0) return;
    event.preventDefault();
    openDay(day.dataset.slug, true);
  });

  document
    .getElementById("cs-change-modal-close")
    .addEventListener("click", closeDay);

  // Clicking the backdrop (anything outside the card) closes the dialog.
  modal.addEventListener("click", (event) => {
    if (event.target === modal) closeDay();
  });

  // Escape: the dialog closes itself, so only the URL needs restoring. The
  // "close" event covers any other way it might be dismissed.
  modal.addEventListener("cancel", restoreListUrl);
  modal.addEventListener("close", restoreListUrl);

  window.addEventListener("popstate", (event) => {
    const slug = event.state && event.state.csChange;
    if (slug) openDay(slug, false);
    else if (modal.open) modal.close();
  });
</script>
