---
// One changelog entry as a card. Rendered on the per-entry page
// (/changelog/<pr>/); the dialog on the list page builds the same markup in
// the browser, so both share the .cs-card and .cs-change-* styles.
import type { ChangeView } from "../lib/changelog";
import { linkRules } from "../lib/rules";

interface Props {
  entry: ChangeView;
}

const { entry } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<div class="cs-card cs-change-card not-content">
  <div class="cs-change-head">
    <time datetime={entry.date}>{entry.date}</time>
    {
      entry.pr != null ? (
        <a class="cs-change-pr" href={entry.prHref}>
          #{entry.pr}
        </a>
      ) : null
    }
    {entry.latest ? <span class="cs-badge latest">Latest</span> : null}
  </div>
  <p class="cs-change-title">{entry.title}</p>
  <p class="cs-change-summary" set:html={linkRules(base, entry.summary)} />
  <p class="cs-card-note">
    One pull request, one entry.
    <a href={`${base}/changelog/`}>See the whole changelog</a>
  </p>
</div>
