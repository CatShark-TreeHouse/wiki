---
// Alphabetical index of Bewares entries, each linking to its own page.
import bewares from "../data/bewares.json";

type Beware = {
  name: string;
  username?: string | null;
  date: string;
  pattern: string;
  status?: string | null;
};

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const rows = (bewares as Beware[])
  .slice()
  .sort((a, b) => a.name.localeCompare(b.name));
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-");
---

{
  rows.length === 0 ? (
    <p>There is nobody on this list right now.</p>
  ) : (
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Username</th>
          <th>Listed</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((b) => (
          <tr>
            <td>
              <a href={`${base}/moderation/bewares/${slug(b.name)}/`}>
                {b.name}
              </a>
            </td>
            <td>{b.username ? `@${b.username}` : "unknown"}</td>
            <td>{b.date}</td>
            <td>{b.status ?? ""}</td>
          </tr>
        ))}
      </tbody>
    </table>
  )
}
