---
// The controlled-content lists. Entries live in src/data/controlled-content.json
// and are edited through pull requests; the page is rendered at build time
// and the search / type filter run in the browser over the baked-in data.
import mascot from "../assets/paw.png";
import { entryViews } from "../lib/entries";

const mascotUrl = mascot.src;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// Each entry carries its slug, permalink and labels so the modal and the
// per-entry page (/controlled/<alias>/) agree on both.
const items = entryViews(base);
---

<div class="cs-lists not-content">
  <div class="cs-controls">
    <label class="cs-search-wrap">
      <svg
        class="cs-search-icon"
        aria-hidden="true"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.8-3.8"></path>
      </svg>
      <input
        id="cs-search"
        type="search"
        placeholder="Search by name…"
        autocomplete="off"
        aria-label="Search controlled content by name"
      />
    </label>
    <select id="cs-type" aria-label="Filter by type">
      <option value="all">All types</option>
      <option value="artist">Artists</option>
      <option value="character">Characters</option>
      <option value="tag">Kinks</option>
    </select>
  </div>
  <div id="cs-content" aria-live="polite"></div>
</div>

<dialog id="cs-modal" class="cs-modal" aria-labelledby="cs-modal-name">
  <div class="cs-card not-content">
    <div class="cs-card-head">
      <span class="cs-card-name" id="cs-modal-name"></span>
      <span class="cs-pill" id="cs-modal-type"></span>
      <span class="cs-badge" id="cs-modal-status"></span>
      <button id="cs-modal-close" type="button" aria-label="Close">
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
    <dl class="cs-card-facts">
      <dt>Reason</dt>
      <dd id="cs-modal-reason"></dd>
      <dt>Added</dt>
      <dd class="cs-added" id="cs-modal-added"></dd>
    </dl>
    <p class="cs-card-note">
      <span id="cs-modal-note"></span>
      <a id="cs-modal-link" href="">Open the full profile</a>
    </p>
  </div>
</dialog>

<style is:global>
  .cs-lists {
    margin-top: 1.5rem;
  }

  .cs-controls {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .cs-search-wrap {
    position: relative;
    flex: 1 1 240px;
    min-width: 0;
    display: block;
  }

  .cs-search-icon {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 0.8rem;
    translate: 0 -50%;
    width: 1rem;
    height: 1rem;
    color: var(--sl-color-gray-3);
    pointer-events: none;
  }

  .cs-controls input,
  .cs-controls select {
    background: var(--sl-color-bg-nav);
    color: var(--sl-color-text);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 999px;
    padding: 0.55rem 1rem;
    font-size: var(--sl-text-sm);
  }

  .cs-controls input {
    width: 100%;
    padding-inline-start: 2.4rem;
  }

  .cs-controls input:focus-visible,
  .cs-controls select:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 1px;
  }

  .cs-section {
    margin-bottom: 2rem;
  }

  .cs-section h2 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--sl-text-h4);
    color: var(--sl-color-white);
    margin: 0 0 0.35rem;
  }

  .cs-section .cs-section-sub {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    margin: 0 0 0.75rem;
  }

  .cs-group {
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    background: var(--cs-card, transparent);
    margin-bottom: 0.6rem;
    overflow: hidden;
  }

  .cs-group > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.7rem 1rem;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .cs-group > summary::-webkit-details-marker {
    display: none;
  }

  .cs-group > summary::before {
    content: "";
    width: 0.45rem;
    height: 0.45rem;
    border-right: 2px solid var(--sl-color-gray-3);
    border-bottom: 2px solid var(--sl-color-gray-3);
    transform: rotate(-45deg);
    transition: transform 0.15s ease;
    margin-inline-end: 0.25rem;
    flex: 0 0 auto;
  }

  .cs-group[open] > summary::before {
    transform: rotate(45deg);
  }

  .cs-group > summary:hover {
    background: color-mix(in srgb, var(--sl-color-accent) 7%, transparent);
  }

  .cs-group-title {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex: 1;
  }

  .cs-anchor,
  .cs-anchor-h {
    text-decoration: none;
    color: inherit;
  }

  .cs-anchor {
    color: var(--sl-color-gray-4);
    font-weight: 700;
    opacity: 0;
    transition: opacity 0.12s ease;
    padding-inline: 0.25rem;
  }

  .cs-group > summary:hover .cs-anchor,
  .cs-anchor:focus-visible {
    opacity: 1;
  }

  .cs-row-link {
    color: inherit;
    text-decoration: none;
  }

  .cs-row-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .cs-panel tr.cs-hit {
    background: color-mix(in srgb, var(--sl-color-accent) 18%, transparent);
  }

  .cs-panel tr[id] {
    scroll-margin-top: calc(var(--sl-nav-height) + 1rem);
  }

  .cs-group,
  .cs-section {
    scroll-margin-top: calc(var(--sl-nav-height) + 1rem);
  }

  .cs-count {
    font-size: var(--sl-text-xs);
    font-weight: 700;
    color: var(--sl-color-gray-3);
    background: var(--sl-color-gray-6);
    border-radius: 999px;
    padding: 0.1rem 0.55rem;
  }

  .cs-group .cs-panel {
    border: none;
    border-top: 1px solid var(--sl-color-hairline);
    border-radius: 0;
    background: transparent;
  }

  .cs-panel {
    background: color-mix(in srgb, var(--sl-color-gray-6) 45%, transparent);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    overflow-x: auto;
  }

  /* The global markdown-table theme rounds tables and their corner cells;
     inside a group the table is flush with the summary, so square it off. */
  .cs-group .cs-panel table,
  .cs-group .cs-panel table th,
  .cs-group .cs-panel table td {
    border-radius: 0 !important;
  }

  .cs-group .cs-panel table {
    border: none !important;
    width: 100% !important;
  }

  .cs-panel table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
  }

  .cs-panel th,
  .cs-panel td {
    text-align: left;
    padding: 0.65rem 0.9rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    vertical-align: top;
  }

  .cs-panel th {
    font-size: var(--sl-text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--sl-color-gray-3);
    background: color-mix(in srgb, var(--sl-color-gray-6) 80%, transparent);
  }

  .cs-panel tbody tr {
    transition: background 0.1s ease;
  }

  .cs-panel tbody tr:hover {
    background: color-mix(in srgb, var(--sl-color-accent) 7%, transparent);
  }

  .cs-panel tr:last-child td {
    border-bottom: none;
  }

  .cs-alias {
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .cs-type {
    white-space: nowrap;
  }

  .cs-reason {
    color: var(--sl-color-gray-2);
  }

  .cs-added {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  .cs-reason.cs-none {
    font-style: italic;
    opacity: 0.6;
  }

  .cs-state {
    padding: 2.5rem 1rem;
    text-align: center;
    color: var(--sl-color-gray-3);
    border: 1px dashed var(--sl-color-hairline);
    border-radius: 0.75rem;
  }

  .cs-state .cs-big {
    font-family: var(--cs-font-display, inherit);
    font-size: var(--sl-text-lg);
    color: var(--sl-color-white);
    margin-bottom: 0.35rem;
  }

  .cs-state .cs-mascot {
    width: 4.5rem;
    height: 4.5rem;
    margin-bottom: 0.75rem;
    opacity: 0.5;
  }

  .cs-state button {
    margin-top: 1rem;
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
    border: none;
    border-radius: 999px;
    padding: 0.5rem 1.2rem;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    cursor: pointer;
  }

  .cs-state button:hover {
    filter: brightness(1.1);
  }

  /* Loading skeleton */
  .cs-skel {
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    padding: 0.9rem;
    display: grid;
    gap: 0.75rem;
  }

  .cs-skel-row {
    height: 1.4rem;
    border-radius: 0.4rem;
    background: linear-gradient(
      100deg,
      var(--sl-color-gray-6) 40%,
      var(--sl-color-gray-5) 50%,
      var(--sl-color-gray-6) 60%
    );
    background-size: 200% 100%;
    animation: cs-shimmer 1.4s linear infinite;
  }

  @keyframes cs-shimmer {
    to {
      background-position: -100% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cs-skel-row {
      animation: none;
    }
  }

  /* Profile modal. The card itself is styled in custom.css, shared with the
     per-entry page; this is only the dialog chrome around it. */
  .cs-modal {
    border: none;
    padding: 0;
    background: transparent;
    color: var(--sl-color-text);
    width: min(30rem, calc(100vw - 2rem));
    max-width: none;
    /* The global reset zeroes margins, which would pin the dialog to the
       top-left corner instead of centring it. */
    margin: auto;
  }

  .cs-modal::backdrop {
    /* Same overlay as Starlight's own search dialog. */
    background: var(--sl-color-backdrop-overlay);
    backdrop-filter: blur(0.25rem);
  }

  .cs-modal .cs-card {
    background: var(--sl-color-bg);
    box-shadow: 0 12px 40px rgb(0 0 0 / 0.35);
  }

  #cs-modal-link {
    margin-inline-start: 0.35rem;
  }

  .cs-modal[open] {
    animation: cs-pop 0.14s ease-out;
  }

  #cs-modal-close {
    margin-inline-start: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    border: none;
    border-radius: 999px;
    background: transparent;
    color: var(--sl-color-gray-3);
    cursor: pointer;
  }

  #cs-modal-close svg {
    width: 1rem;
    height: 1rem;
  }

  #cs-modal-close:hover {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }

  @keyframes cs-pop {
    from {
      opacity: 0;
      transform: translateY(4px) scale(0.98);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cs-modal[open] {
      animation: none;
    }
  }
</style>

<script is:inline define:vars={{ items, mascotUrl }}>
  const contentEl = document.getElementById("cs-content");
  const searchEl = document.getElementById("cs-search");
  const typeEl = document.getElementById("cs-type");

  const STATUS_NOTES = {
    banned: "Not allowed anywhere in the network, stickers included.",
    controlled: "Allowed only behind a spoiler and with a content warning.",
  };

  let allItems = Array.isArray(items) ? items : [];

  function slug(value) {
    return String(value)
      .toLowerCase()
      .normalize("NFKD")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");
  }

  function esc(value) {
    return String(value).replace(
      /[&<>"']/g,
      (c) =>
        ({
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#39;",
        })[c],
    );
  }

  function showEmpty(filtered) {
    const msg = filtered
      ? "No entries match your search."
      : "Nothing is controlled right now.";
    const clear = filtered
      ? '<div><button id="cs-clear">Clear filters</button></div>'
      : "";
    contentEl.innerHTML =
      '<div class="cs-state">' +
      '<img class="cs-mascot" src="' +
      mascotUrl +
      '" alt="" width="72" height="72" />' +
      '<div class="cs-big">' +
      esc(msg) +
      "</div>" +
      clear +
      "</div>";
    document.getElementById("cs-clear")?.addEventListener("click", () => {
      searchEl.value = "";
      typeEl.value = "all";
      applyFilters();
    });
  }

  function tableFor(items) {
    let rows = "";
    for (const item of items) {
      const id = item.slug;
      const reason =
        item.reason == null || item.reason === ""
          ? '<span class="cs-reason cs-none">none</span>'
          : '<span class="cs-reason">' + esc(item.reason) + "</span>";
      rows +=
        '<tr id="' +
        esc(id) +
        '">' +
        '<td class="cs-alias"><a class="cs-row-link" href="' +
        esc(item.href) +
        '" data-slug="' +
        esc(id) +
        '">' +
        esc(item.alias ?? "") +
        "</a></td>" +
        "<td>" +
        reason +
        "</td>" +
        '<td class="cs-added">' +
        esc(item.added ?? "") +
        "</td>" +
        "</tr>";
    }
    return (
      '<div class="cs-panel"><table><thead><tr>' +
      "<th>Name</th><th>Reason</th><th>Added</th>" +
      "</tr></thead><tbody>" +
      rows +
      "</tbody></table></div>"
    );
  }

  const GROUPS = [
    ["artist", "Artists"],
    ["character", "Characters"],
    ["tag", "Kinks"],
  ];

  function groupFor(status, type, label, items, forceOpen) {
    const open = forceOpen ? " open" : "";
    const id = status + "-" + slug(label);
    return (
      '<details class="cs-group cs-group-' +
      type +
      '" id="' +
      id +
      '"' +
      open +
      ">" +
      '<summary><span class="cs-group-title">' +
      esc(label) +
      '</span><a class="cs-anchor" href="#' +
      id +
      '" aria-label="Link to this list">#</a><span class="cs-count">' +
      items.length +
      "</span></summary>" +
      tableFor(items) +
      "</details>"
    );
  }

  function sectionFor(status, title, sub, items, forceOpen) {
    let groups = "";
    for (const [type, label] of GROUPS) {
      const subset = items.filter((item) => item.type === type);
      if (subset.length)
        groups += groupFor(status, type, label, subset, forceOpen);
    }
    return (
      '<section class="cs-section" id="' +
      status +
      '">' +
      '<h2><a class="cs-anchor-h" href="#' +
      status +
      '">' +
      esc(title) +
      "</a>" +
      ' <span class="cs-badge ' +
      status +
      '">' +
      items.length +
      "</span></h2>" +
      '<p class="cs-section-sub">' +
      esc(sub) +
      "</p>" +
      groups +
      "</section>"
    );
  }

  function render(items, forceOpen) {
    if (!items.length) {
      showEmpty(allItems.length > 0);
      return;
    }
    const banned = items.filter((item) => item.status === "banned");
    const controlled = items.filter((item) => item.status === "controlled");

    let html = "";
    if (banned.length) {
      html += sectionFor(
        "banned",
        "Banned",
        STATUS_NOTES.banned,
        banned,
        forceOpen,
      );
    }
    if (controlled.length) {
      html += sectionFor(
        "controlled",
        "Controlled",
        STATUS_NOTES.controlled,
        controlled,
        forceOpen,
      );
    }
    contentEl.innerHTML = html;
  }

  function applyFilters() {
    const query = searchEl.value.trim().toLowerCase();
    const type = typeEl.value;
    // Groups start collapsed (the lists will grow); a search or a type
    // filter means the reader is looking for something, so open them.
    const forceOpen = Boolean(query) || type !== "all";
    render(
      allItems.filter((item) => {
        const matchesType = type === "all" || item.type === type;
        const matchesQuery =
          !query ||
          String(item.alias ?? "")
            .toLowerCase()
            .includes(query);
        return matchesType && matchesQuery;
      }),
      forceOpen,
    );
  }

  // Deep links: #banned, #banned-artists, or #<alias>. Open the group that
  // contains the target and scroll to it.
  function revealHash() {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    const target = document.getElementById(id);
    if (!target || !contentEl.contains(target)) return;
    let node = target;
    while (node && node !== contentEl) {
      if (node.tagName === "DETAILS") node.open = true;
      node = node.parentElement;
    }
    if (target.tagName === "TR") target.classList.add("cs-hit");
    target.scrollIntoView({ block: "start" });
  }

  // The profile modal. A row's name links to the entry's own page, so a
  // middle-click or a copied link still works; a plain click opens the modal
  // here and pushes that same URL, which keeps the address bar shareable.
  const modal = document.getElementById("cs-modal");
  const modalFields = {
    name: document.getElementById("cs-modal-name"),
    type: document.getElementById("cs-modal-type"),
    status: document.getElementById("cs-modal-status"),
    reason: document.getElementById("cs-modal-reason"),
    added: document.getElementById("cs-modal-added"),
    note: document.getElementById("cs-modal-note"),
    link: document.getElementById("cs-modal-link"),
  };
  const bySlug = new Map(allItems.map((item) => [item.slug, item]));
  const listUrl = location.pathname + location.search;
  // Set while a restore is in flight, so the several ways of closing the
  // dialog cannot each push the browser back.
  let restoring = false;

  function openEntry(entrySlug, push) {
    const item = bySlug.get(entrySlug);
    if (!item) return;
    modalFields.name.textContent = item.alias ?? "";
    modalFields.type.textContent = item.typeLabel ?? "";
    modalFields.type.className = "cs-pill " + (item.type ?? "");
    modalFields.status.textContent = item.statusLabel ?? "";
    modalFields.status.className = "cs-badge " + (item.status ?? "");
    modalFields.reason.textContent = item.reason || "none recorded";
    modalFields.reason.classList.toggle("cs-none", !item.reason);
    modalFields.reason.classList.toggle("cs-reason", !item.reason);
    modalFields.added.textContent = item.added ?? "";
    modalFields.note.textContent = STATUS_NOTES[item.status] ?? "";
    modalFields.link.href = item.href;
    if (push) history.pushState({ csEntry: entrySlug }, "", item.href);
    if (!modal.open) modal.showModal();
  }

  // Put the list URL back after the dialog is dismissed: step back over the
  // entry we pushed, or rewrite the URL if the browser refuses the traversal.
  function restoreListUrl() {
    if (restoring) return;
    if (location.pathname + location.search === listUrl) return;
    restoring = true;
    if (history.state && history.state.csEntry) history.back();
    else history.replaceState(null, "", listUrl);
    setTimeout(() => {
      if (location.pathname + location.search !== listUrl)
        history.replaceState(null, "", listUrl);
      restoring = false;
    }, 200);
  }

  function closeEntry() {
    restoreListUrl();
    if (modal.open) modal.close();
  }

  contentEl.addEventListener("click", (event) => {
    const link = event.target.closest("a.cs-row-link");
    if (!link || !link.dataset.slug) return;
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
      return;
    if (event.button !== 0) return;
    event.preventDefault();
    openEntry(link.dataset.slug, true);
  });

  document
    .getElementById("cs-modal-close")
    .addEventListener("click", closeEntry);

  // Clicking the backdrop (anything outside the card) closes the dialog.
  modal.addEventListener("click", (event) => {
    if (event.target === modal) closeEntry();
  });

  // Escape: the dialog closes itself, so only the URL needs restoring. The
  // "close" event covers any other way it might be dismissed.
  modal.addEventListener("cancel", restoreListUrl);
  modal.addEventListener("close", restoreListUrl);

  window.addEventListener("popstate", (event) => {
    const entrySlug = event.state && event.state.csEntry;
    if (entrySlug) openEntry(entrySlug, false);
    else if (modal.open) modal.close();
  });

  searchEl.addEventListener("input", applyFilters);
  typeEl.addEventListener("change", applyFilters);
  window.addEventListener("hashchange", revealHash);

  applyFilters();
  revealHash();
</script>
